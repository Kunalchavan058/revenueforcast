# Run: uv run python scripts/configure_database.py
# That command generates missing local credentials in ignored .env without printing them.
API_BASE_URL=http://127.0.0.1:8000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://retailforecast:replace_with_local_password@127.0.0.1:5432/retailforecast
# Run: uv run python scripts/configure_mlflow.py (after PostgreSQL is healthy)
MLFLOW_TRACKING_URI=postgresql+psycopg://retailforecast_mlflow:replace_with_local_password@127.0.0.1:5432/retailforecast_mlflow
